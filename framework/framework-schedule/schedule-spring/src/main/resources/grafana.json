          "fields": "",
          "values": false
        },
        "showUnfilled": true
      },
      "pluginVersion": "9.5.2",
      "targets": [
        {
          "expr": "sum by (taskCode, status) (task_status_count_total{application=\"my-task\", env=\"production\"})",
          "format": "table",
          "interval": "",
          "legendFormat": "{{taskCode}} - {{status}}",
          "refId": "A"
        }
      ],
      "title": "任务状态累计计数 (按状态分组)",
      "type": "bargauge"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
          },
          "mappings": [],
          "unit": "short"
        },
        "overrides": [
