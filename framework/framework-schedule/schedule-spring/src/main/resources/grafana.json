        {
          "expr": "sum by (taskCode) (task_status_count_total{application=\"my-task\", env=\"production\", status=\"COMPLETED\"})",
          "format": "table",
          "interval": "",
          "legendFormat": "已完成",
          "refId": "A"
        },
        {
          "expr": "sum by (taskCode) (task_status_count_total{application=\"my-task\", env=\"production\", status=\"STARTED\"})",
          "format": "table",
          "interval": "",
          "legendFormat": "进行中",
          "refId": "B"
