          "mode": "multi",
          "sort": "none"
        }
      },
      "pluginVersion": "9.5.2",
      "targets": [
        {
          "expr": "task_execution_duration_seconds{application=\"my-task\", env=\"production\", quantile=\"0.5\"}",
          "format": "time_series",
          "interval": "",
          "intervalFactor": 1,
          "legendFormat": "{{taskCode}} P50",
          "metric": "",
          "refId": "A"
        },
        {
          "expr": "task_execution_duration_seconds{application=\"my-task\", env=\"production\", quantile=\"0.95\"}",
          "format": "time_series",
          "interval": "",
          "legendFormat": "{{taskCode}} P95",
          "refId": "B"
        },
        {
          "expr": "task_execution_duration_seconds{application=\"my-task\", env=\"production\", quantile=\"0.99\"}",
          "format": "time_series",
          "interval": "",
          "legendFormat": "{{taskCode}} P99",
          "refId": "C"
        },
        {
          "expr": "task_execution_duration_seconds_max{application=\"my-task\", env=\"production\"}",
          "format": "time_series",
          "interval": "",
          "legendFormat": "{{taskCode}} Max",
          "refId": "D"
        }
      ],
      "title": "任务执行耗时 (分位数 & 最大值)",
