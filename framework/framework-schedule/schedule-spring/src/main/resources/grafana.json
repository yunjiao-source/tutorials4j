      "pluginVersion": "9.5.2",
      "targets": [
        {
          "expr": "task_active_count{application=\"my-task\", env=\"production\"}",
          "format": "time_series",
          "interval": "",
          "legendFormat": "{{taskCode}}",
          "refId": "A"
        }
      ],
      "title": "任务活跃数 (当前)",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "id": 7,
